# CloudSpace adapter auth - Production Environment
# Set these as environment variables in your deployment target.
#
# Production topology (reverse-proxy model — the browser only talks to the frontend origin):
#   Browser  -> https://cloud.icingtree.com              (React SPA + nginx)
#                 nginx proxies /api and /ws             -> https://cloudapi.icingtree.com  (this adapter)
#                 the adapter calls Nextcloud server-side -> https://nc.icingtree.com        (Nextcloud)
# Because the browser uses same-origin /api paths, no CORS is needed on the adapter.

# Express adapter (runs at cloudapi.icingtree.com)
NODE_ENV=production
PORT=5000
NC_BASE_URL=https://nc.icingtree.com
FRONTEND_URL=https://cloud.icingtree.com
SESSION_SECRET=replace-with-a-long-random-secret-min-32-chars
SESSION_DB_PATH=./sessions.db
SESSION_COOKIE_SECURE=true
SESSION_TTL_SECONDS=43200
ALLOW_MOCK_SERVICES=false
NEXTCLOUD_BOOTSTRAP_STRATEGY=exchange-or-direct
NEXTCLOUD_APP_PASSWORD_LABEL=CloudSpace Adapter

# Keycloak SSO — the adapter is a DIRECT OIDC client of Keycloak (see PRODUCTION_KEYCLOAK.md).
# No Nextcloud OAuth2 client / consent screens; Nextcloud validates the Keycloak access token
# as a Bearer via the user_oidc app (check-bearer + bearer-provisioning).
# The SECRET stays here (server-side) and must never appear in the frontend bundle or git.
OAUTH_CLIENT_ID=nextcloud_new_UI
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://cloud.icingtree.com/api/auth/callback
OAUTH_AUTHORIZE_URL=https://keycloak.spacepe.in/realms/paas/protocol/openid-connect/auth
OAUTH_TOKEN_URL=https://keycloak.spacepe.in/realms/paas/protocol/openid-connect/token
OAUTH_SCOPE=openid profile email

# Optional
# REDIS_URL=redis://localhost:6379        # horizontal scale + cross-instance realtime
# NOTIF_POLL_MS=15000                      # notification poll interval (notify_push fallback)
# ANTHROPIC_API_KEY=sk-ant-...             # enables AI meeting notes + Ask CloudSpace

# Frontend build/preview. The static SPA calls relative /api, proxied by cloud.icingtree.com's
# nginx; these only matter if you serve the frontend via `vite preview` rather than static nginx.
VITE_PORT=5173
VITE_API_PROXY_TARGET=https://cloudapi.icingtree.com
VITE_NEXTCLOUD_PROXY_TARGET=https://nc.icingtree.com
# Public (client id is safe to ship to the browser; the secret above is NOT)
VITE_OAUTH_CLIENT_ID=
VITE_OAUTH_REDIRECT_URI=https://cloud.icingtree.com/api/auth/callback
